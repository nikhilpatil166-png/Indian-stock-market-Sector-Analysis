# Copy this file to .streamlit/secrets.toml on your own computer.
# Keep the real secrets.toml local. It is ignored by Git.

ANGELONE_API_KEY = "paste-your-SmartAPI-api-key-here"
ANGELONE_CLIENT_CODE = "your-Angel-One-client-code"
ANGELONE_PIN = "your-Angel-One-login-PIN"

# Optional: set this if automatic public IPv4 lookup is blocked.
# ANGELONE_CLIENT_PUBLIC_IP = "your-current-public-ipv4"
